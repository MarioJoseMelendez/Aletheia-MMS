{
  "name": "aletheia",
  "version": "1.0.0",
  "description": "Aletheia — Simulador de Macromoléculas Biológicas (Cloudflare)",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:worker\" \"npm run dev:client\"",
    "dev:worker": "wrangler dev",
    "dev:client": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.12.31",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240718.0",
    "concurrently": "^9.1.0",
    "vite": "^6.3.0",
    "wrangler": "^3.67.0"
  }
}
